<!DOCTYPE html>
<html>
<head>
  <title>Slax</title>

  <%= csrf_meta_tags %>
  <%= stylesheet_link_tag    'application', media: 'all' %>
  <%= javascript_include_tag 'application' %>

  <link href="https://fonts.googleapis.com/css?family=Open+Sans:400,600,700,800" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css?family=EB+Garamond:700" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css?family=Lato:400,700,900" rel="stylesheet">

  <%= render 'application/favicon' %>

  <% if ENV['PUSHER_KEY'].present? %>
    <script src="https://js.pusher.com/4.1/pusher.min.js"></script>
    <script>
      var pusher = new Pusher('<%= ENV['PUSHER_KEY'] %>', {
        cluster: '<%= ENV.fetch('PUSHER_CLUSTER', 'us2') %>',
        encrypted: true
      });
    </script>
  <% else %>
    <!-- No Pusher key configured: realtime updates disabled, everything else works. -->
    <script>
      var pusher = {
        subscribe: function() { return { bind: function() {}, unbind: function() {} }; },
        unsubscribe: function() {}
      };
    </script>
  <% end %>
  <% if ENV['GIPHY_API_KEY'].present? %>
    <script>window.GIPHY_API_KEY = '<%= j ENV['GIPHY_API_KEY'] %>';</script>
  <% end %>
</head>

<body>
  <%= yield %>
</body>
</html>
